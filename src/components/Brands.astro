---
import { BRANDS } from "../data/site";
import SectionDivider from "./SectionDivider.astro";
const track = [...BRANDS, ...BRANDS];
---

<section id="marcas" class="relative py-20 md:py-24 bg-white border-t border-vacrc-ink-100">
  <SectionDivider />
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="text-center max-w-2xl mx-auto" data-aos="fade-up">
      <span class="text-eyebrow text-vacrc-blue-600 font-montserrat font-bold text-[0.99rem] text-justify">Respaldo de fábrica</span>
      <h2 class="text-h2 mt-3 text-metal">
        Trabajamos con las marcas líderes del sector
      </h2>
    </div>
  </div>

  <div class="relative mt-12 overflow-hidden" data-aos="fade-up" data-aos-delay="600">
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-24 bg-gradient-to-r from-white to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-24 bg-gradient-to-l from-white to-transparent z-10"></div>

    <div class="flex w-max animate-marquee">
      {track.map((brand) => (
        <div class="flex items-center justify-center shrink-0 w-44 h-24 mx-4">
          <img
            src={`/brands/${brand.slug}.png`}
            alt={brand.name}
            class="max-h-10 max-w-[140px] object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <span class="text-fallback-brand hidden items-center justify-center w-full h-full text-vacrc-ink-300 hover:text-vacrc-blue-600 transition-colors duration-300">
            {brand.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
