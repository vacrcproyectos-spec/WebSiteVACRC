---
interface Props {
    src: string;
    alt: string;
    class?: string;
    glow?: boolean;
}

const { src, alt, class: className = "w-5 h-5", glow = false } = Astro.props;

const maskStyle = `-webkit-mask-image:url(${src});mask-image:url(${src});-webkit-mask-size:contain;mask-size:contain;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;`;
---

<span
        role="img"
        aria-label={alt}
        class:list={[
            "inline-block bg-current shrink-0 transition-all duration-300 ease-out",
            glow ? "drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]" : "",
            className
        ]}
        style={maskStyle}
></span>
