---
import "toastify-js/src/toastify.css";
import { SITE, SOCIAL } from "../data/site";
import Icon from "./Icon.astro";
import Button from "./Button.astro";

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL.replace(/\/$/, "");
const CONTACT_API_URL = `${API_BASE_URL}/api/v1/contact/send-email`;
const CAPTCHA_API_URL = `${API_BASE_URL}/api/v1/captcha`;
const CONTACT_API_KEY = import.meta.env.PUBLIC_CONTACT_API_KEY;
---

<section id="contacto" class="relative py-24 md:py-32 bg-vacrc-bg border-t border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">

    <!-- Encabezado Editorial / Bugatti Style -->
    <div class="mb-16 md:mb-20" data-aos="fade-up">
      <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-3">
        Contacto & Asesoría
      </span>
      <h2 class="text-3xl sm:text-5xl lg:text-7xl font-display font-bold text-white tracking-tight leading-tight">
        Hablemos de tu proyecto
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- Columna Información de Contacto -->
      <div class="lg:col-span-5 space-y-10" data-aos="fade-up">
        <p class="text-white/70 font-montserrat font-light text-base sm:text-lg leading-relaxed">
          Cuéntanos tus requerimientos térmicos o de climatización y te entregamos una propuesta de ingeniería detallada a la medida sin compromiso.
        </p>

        <!-- Bloque de Canales Directos -->
        <div class="border-y border-white/10 divide-y divide-white/10">

          <!-- Teléfono -->
          <div class="py-6 group flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="text-xs font-mono tracking-widest text-vacrc-cyan-400">01 //</span>
              <div>
                <span class="text-[0.7rem] uppercase tracking-widest text-white/40 block font-montserrat">Línea Directa</span>
                <a href={`tel:${SITE.phone.replace(/\s+/g, "")}`} class="text-white font-display font-bold text-lg sm:text-xl hover:text-vacrc-cyan-400 transition-colors">
                  {SITE.phone}
                </a>
              </div>
            </div>
            <button
                type="button"
                data-copy={SITE.phone}
                aria-label="Copiar teléfono"
                class="copy-btn cursor-pointer opacity-50 group-hover:opacity-100 transition-opacity text-white/50 hover:text-vacrc-cyan-400 p-2"
            >
              <Icon icon="copy" class="w-5 h-5" />
            </button>
          </div>

          <!-- Correo -->
          <div class="py-6 group flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="text-xs font-mono tracking-widest text-vacrc-cyan-400">02 //</span>
              <div>
                <span class="text-[0.7rem] uppercase tracking-widest text-white/40 block font-montserrat">Correo Electrónico</span>
                <a id="contact-email-link" href={`mailto:${SITE.email}`} class="text-white font-display font-bold text-lg sm:text-xl hover:text-vacrc-cyan-400 transition-colors">
                  {SITE.email}
                </a>
              </div>
            </div>
            <button
                type="button"
                data-copy={SITE.email}
                aria-label="Copiar correo"
                class="copy-btn cursor-pointer opacity-50 group-hover:opacity-100 transition-opacity text-white/50 hover:text-vacrc-cyan-400 p-2"
            >
              <Icon icon="copy" class="w-5 h-5" />
            </button>
          </div>

          <!-- Ubicación -->
          <div class="py-6 flex items-center gap-4">
            <span class="text-xs font-mono tracking-widest text-vacrc-cyan-400">03 //</span>
            <div>
              <span class="text-[0.7rem] uppercase tracking-widest text-white/40 block font-montserrat">Ubicación</span>
              <p class="text-white font-display font-bold text-base sm:text-lg">
                {SITE.address}
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Formulario de Contacto / Estilo Showcase Bugatti -->
      <form
          id="contact-form"
          class="lg:col-span-7 bg-black/40 border border-white/10 p-6 sm:p-10 flex flex-col gap-5 relative"
          data-aos="fade-up"
          data-aos-delay="200"
      >
        <!-- Campo Nombre -->
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 peer-focus:text-vacrc-cyan-400 transition-colors pointer-events-none">
            <Icon icon="user" class="w-4 h-4" />
          </span>
          <input
              id="contact-nombre"
              type="text"
              name="nombre"
              required
              placeholder=" "
              class="peer w-full border border-white/15 bg-white/[0.03] pl-11 pr-10 pt-5 pb-2 font-montserrat text-[0.95rem] text-white placeholder-transparent focus:outline-none focus:border-vacrc-cyan-400 transition-colors [&:user-valid]:border-emerald-400 [&:user-invalid]:border-red-400"
          />
          <label
              for="contact-nombre"
              class="absolute left-11 top-1/2 -translate-y-1/2 text-[0.85rem] uppercase tracking-wider text-white/40 pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:translate-y-0 peer-focus:text-[0.65rem] peer-focus:text-vacrc-cyan-400 peer-[&:not(:placeholder-shown)]:top-2.5 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[0.65rem]"
          >
            Nombre Completo
          </label>
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-red-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>

        <!-- Campo Teléfono -->
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 peer-focus:text-vacrc-cyan-400 transition-colors pointer-events-none">
            <Icon icon="phone" class="w-4 h-4" />
          </span>
          <input
              id="contact-telefono"
              type="tel"
              name="telefono"
              required
              inputmode="tel"
              pattern="[0-9+\-\s\(\)]{7,20}"
              title="Ingresa un teléfono válido (solo números, espacios, +, - o paréntesis)"
              placeholder=" "
              class="peer w-full border border-white/15 bg-white/[0.03] pl-11 pr-10 pt-5 pb-2 font-montserrat text-[0.95rem] text-white placeholder-transparent focus:outline-none focus:border-vacrc-cyan-400 transition-colors [&:user-valid]:border-emerald-400 [&:user-invalid]:border-red-400"
          />
          <label
              for="contact-telefono"
              class="absolute left-11 top-1/2 -translate-y-1/2 text-[0.85rem] uppercase tracking-wider text-white/40 pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:translate-y-0 peer-focus:text-[0.65rem] peer-focus:text-vacrc-cyan-400 peer-[&:not(:placeholder-shown)]:top-2.5 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[0.65rem]"
          >
            Teléfono de Contacto
          </label>
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-red-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>

        <!-- Servicio de Interés -->
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 pointer-events-none">
            <Icon icon="target" class="w-4 h-4" />
          </span>
          <label for="contact-servicio" class="absolute left-11 top-2 text-[0.65rem] uppercase tracking-wider text-white/40 pointer-events-none">
            Servicio Requerido
          </label>
          <select
              id="contact-servicio"
              name="servicio"
              class="w-full border border-white/15 bg-white/[0.03] pl-11 pr-4 pt-5 pb-2 font-montserrat text-[0.95rem] text-white focus:outline-none focus:border-vacrc-cyan-400 transition-colors"
          >
            <option class="text-vacrc-ink-900" selected>Cotización de Proyectos</option>
          </select>
        </div>

        <!-- Mensaje -->
        <div class="relative">
          <span class="absolute left-4 top-4 text-white/30 peer-focus:text-vacrc-cyan-400 transition-colors pointer-events-none">
            <Icon icon="message" class="w-4 h-4" />
          </span>
          <textarea
              id="contact-mensaje"
              name="mensaje"
              rows="4"
              required
              placeholder=" "
              class="peer w-full border border-white/15 bg-white/[0.03] pl-11 pr-10 pt-6 pb-2 font-montserrat text-[0.95rem] text-white placeholder-transparent focus:outline-none focus:border-vacrc-cyan-400 transition-colors resize-none [&:user-valid]:border-emerald-400 [&:user-invalid]:border-red-400"
          ></textarea>
          <label
              for="contact-mensaje"
              class="absolute left-11 top-4 text-[0.85rem] uppercase tracking-wider text-white/40 pointer-events-none transition-all duration-200 peer-focus:top-2 peer-focus:text-[0.65rem] peer-focus:text-vacrc-cyan-400 peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:text-[0.65rem]"
          >
            Detalles del Proyecto
          </label>
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-4 pointer-events-none text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-4 pointer-events-none text-red-400">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>

        <!-- Captcha -->
        <div class="pt-2">
          <label class="text-[0.7rem] uppercase tracking-wider text-white/40 block mb-2 font-montserrat">
            Código de Verificación
          </label>
          <div class="flex flex-col gap-3">

            <!-- Fila del Captcha + Botón -->
            <div class="flex items-center gap-3 w-full">

              <!-- Contenedor de la Imagen: Ahora usa 'flex-1' para expandirse a lo ancho -->
              <div class="relative flex-1 h-12 border border-white/15 bg-black/60 overflow-hidden flex items-center justify-center">
        <span id="captcha-placeholder" class="text-white/30">
          <Icon icon="shield" class="w-5 h-5" />
        </span>
                <img
                    id="captcha-image"
                    alt="Código de verificación"
                    class="absolute inset-0 w-full h-full object-contain hidden transition-opacity"
                />
              </div>

              <!-- Botón de Recarga (Mantiene su tamaño fijo) -->
              <button
                  type="button"
                  id="captcha-refresh"
                  aria-label="Generar nuevo código"
                  class="shrink-0 w-12 h-12 border border-white/15 bg-white/[0.03] flex items-center justify-center text-white/50 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400 transition-colors cursor-pointer"
              >
                <Icon icon="refresh" class="w-4 h-4" />
              </button>

            </div>

            <!-- Campo para ingresar el código -->
            <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 peer-focus:text-vacrc-cyan-400 transition-colors pointer-events-none">
        <Icon icon="shield" class="w-4 h-4" />
      </span>
              <input
                  id="contact-captcha"
                  type="text"
                  name="captcha_code"
                  required
                  autocomplete="off"
                  placeholder=" "
                  class="peer w-full bg-white/[0.03] border border-white/15 pl-11 pr-4 pt-5 pb-2 font-montserrat text-[0.95rem] text-white placeholder-transparent focus:outline-none focus:border-vacrc-cyan-400 transition-colors"
              />
              <label
                  for="contact-captcha"
                  class="absolute left-11 top-1/2 -translate-y-1/2 text-[0.85rem] uppercase tracking-wider text-white/40 pointer-events-none transition-all duration-200 peer-focus:top-2.5 peer-focus:translate-y-0 peer-focus:text-[0.65rem] peer-focus:text-vacrc-cyan-400 peer-[&:not(:placeholder-shown)]:top-2.5 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[0.65rem]"
              >
                Ingresa el Código
              </label>
            </div>

          </div>
        </div>
        <!-- Botones de Acción -->
        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <Button id="send-email" type="button" variant="secondary-light" icon="email" iconPosition="left" class="flex-1">
            Enviar correo
          </Button>
          <Button id="send-whatsapp" type="button" icon="whatsapp" iconPosition="left" class="flex-1">
            Enviar WhatsApp
          </Button>
        </div>
      </form>
    </div>
  </div>
</section>

<style is:global>
  .toastify {
    font-family: var(--font-montserrat);
    font-size: 0.85rem;
    border-radius: 0px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.85rem 1.25rem;
    box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .toastify.toast-success {
    background: #059669;
  }
  .toastify.toast-error {
    background: #dc2626;
  }
</style>

<script>
  import Toastify from "toastify-js";
  window.Toastify = Toastify;
</script>

<script define:vars={{ email: SITE.email, whatsapp: SOCIAL.whatsapp, apiUrl: CONTACT_API_URL, captchaApiUrl: CAPTCHA_API_URL, apiKey: CONTACT_API_KEY }}>
  const form = document.getElementById("contact-form");
  const nombreEl = document.getElementById("contact-nombre");
  const telefonoEl = document.getElementById("contact-telefono");
  const servicioEl = document.getElementById("contact-servicio");
  const mensajeEl = document.getElementById("contact-mensaje");
  const captchaCodeEl = document.getElementById("contact-captcha");
  const captchaImageEl = document.getElementById("captcha-image");
  const captchaPlaceholderEl = document.getElementById("captcha-placeholder");
  const captchaRefreshBtn = document.getElementById("captcha-refresh");
  const sendEmailBtn = document.getElementById("send-email");

  let captchaUuid = null;
  let captchaExpireTimer = null;

  const showCaptchaPlaceholder = () => {
    captchaImageEl.classList.add("hidden");
    captchaImageEl.removeAttribute("src");
    captchaPlaceholderEl.classList.remove("hidden");
  };

  const loadCaptcha = async () => {
    window.clearTimeout(captchaExpireTimer);
    captchaImageEl.classList.add("opacity-40");
    captchaCodeEl.value = "";
    try {
      const res = await fetch(captchaApiUrl, {
        headers: { "X-API-Token": apiKey },
      });
      if (!res.ok) throw new Error(`Captcha request failed with status ${res.status}`);
      const json = await res.json();
      const { uuid, image, expire_seconds } = json.data;
      captchaUuid = uuid;
      captchaImageEl.src = `data:image/jpeg;base64,${image}`;
      captchaImageEl.classList.remove("hidden");
      captchaPlaceholderEl.classList.add("hidden");
      captchaExpireTimer = window.setTimeout(loadCaptcha, (expire_seconds || 300) * 1000);
    } catch (err) {
      captchaUuid = null;
      showCaptchaPlaceholder();
    } finally {
      captchaImageEl.classList.remove("opacity-40");
    }
  };

  captchaRefreshBtn?.addEventListener("click", loadCaptcha);
  loadCaptcha();

  const getValues = () => ({
    nombre: nombreEl.value.trim(),
    telefono: telefonoEl.value.trim(),
    servicio: servicioEl.value,
    mensaje: mensajeEl.value.trim(),
  });

  // Only allow phone-appropriate characters as the user types.
  telefonoEl.addEventListener("input", () => {
    telefonoEl.value = telefonoEl.value.replace(/[^0-9+\-\s()]/g, "");
  });

  const showStatus = (message, isError) => {
    window.Toastify({
      text: message,
      duration: isError ? 7000 : 6000,
      close: true,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      className: isError ? "toast-error" : "toast-success",
    }).showToast();
  };

  const mailtoFallback = (e) => {
    e?.preventDefault();
    const { nombre, telefono, servicio, mensaje } = getValues();
    const subject = `Solicitud de cotización - ${servicio}`;
    const body =
        `Nombre: ${nombre}\n` +
        `Teléfono: ${telefono}\n` +
        `Servicio de interés: ${servicio}\n\n` +
        `Mensaje:\n${mensaje}`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  const sendEmailBtnDefaultHTML = sendEmailBtn.innerHTML;
  const SEND_SPINNER_HTML =
      '<svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
      '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
      '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>' +
      "</svg><span>Enviando...</span>";
  const SEND_SUCCESS_HTML =
      '<svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">' +
      '<path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>' +
      "<span>Enviado</span>";

  const sendEmailApi = async (e) => {
    e?.preventDefault();

    if (sendEmailBtn.disabled) return;

    if (
        !nombreEl.value.trim() ||
        !telefonoEl.value.trim() ||
        !mensajeEl.value.trim() ||
        !captchaCodeEl.value.trim() ||
        !form.checkValidity()
    ) {
      form.reportValidity();
      return;
    }

    if (!captchaUuid) {
      showStatus("No pudimos cargar el código de seguridad. Intenta de nuevo.", true);
      loadCaptcha();
      return;
    }

    const { nombre, telefono, servicio, mensaje } = getValues();
    const captcha_uuid = captchaUuid;
    const captcha_code = captchaCodeEl.value.trim();
    sendEmailBtn.disabled = true;
    sendEmailBtn.classList.add("opacity-60", "cursor-not-allowed");
    sendEmailBtn.innerHTML = SEND_SPINNER_HTML;

    try {
      const res = await fetch(apiUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-API-Token": apiKey,
        },
        body: JSON.stringify({ nombre, telefono, servicio, mensaje, captcha_uuid, captcha_code }),
      });

      if (!res.ok) throw new Error(`Request failed with status ${res.status}`);

      showStatus("¡Listo! Tu solicitud fue enviada correctamente.", false);
      form.reset();
      sendEmailBtn.innerHTML = SEND_SUCCESS_HTML;
      loadCaptcha();
      window.setTimeout(() => {
        sendEmailBtn.disabled = false;
        sendEmailBtn.classList.remove("opacity-60", "cursor-not-allowed");
        sendEmailBtn.innerHTML = sendEmailBtnDefaultHTML;
      }, 3000);
    } catch (err) {
      showStatus("No pudimos enviar tu solicitud. Verifica el código de seguridad e intenta de nuevo.", true);
      sendEmailBtn.disabled = false;
      sendEmailBtn.classList.remove("opacity-60", "cursor-not-allowed");
      sendEmailBtn.innerHTML = sendEmailBtnDefaultHTML;
      loadCaptcha();
    }
  };

  sendEmailBtn?.addEventListener("click", sendEmailApi);
  document.getElementById("contact-email-link")?.addEventListener("click", mailtoFallback);

  document.getElementById("send-whatsapp")?.addEventListener("click", () => {
    const { nombre, telefono, mensaje } = getValues();
    const text =
        `Hola, soy ${nombre || "un cliente interesado"}.\n` +
        `Teléfono: ${telefono || "no proporcionado"}.\n` +
        `Mensaje: ${mensaje || "Quiero más información sobre sus proyectos de climatización."}`;
    window.open(`${whatsapp}?text=${encodeURIComponent(text)}`, "_blank");
  });

  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const value = btn.getAttribute("data-copy");
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        return;
      }
      const original = btn.innerHTML;
      btn.innerHTML = '<svg viewBox="0 0 20 20" fill="none" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>';
      btn.classList.add("text-emerald-400");
      window.setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove("text-emerald-400");
      }, 1500);
    });
  });
</script>
