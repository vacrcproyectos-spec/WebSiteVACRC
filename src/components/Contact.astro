---
import "toastify-js/src/toastify.css";
import { SITE, SOCIAL } from "../data/site";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import SectionDivider from "./SectionDivider.astro";

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL.replace(/\/$/, "");
const CONTACT_API_URL = `${API_BASE_URL}/api/v1/contact/send-email`;
const CAPTCHA_API_URL = `${API_BASE_URL}/api/v1/captcha`;
const CONTACT_API_KEY = import.meta.env.PUBLIC_CONTACT_API_KEY;
---

<section id="contacto" class="relative py-24 md:py-32 bg-white border-t border-vacrc-ink-100">
  <SectionDivider />
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-vacrc-ink-100 blur-[100px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 grid grid-cols-1 lg:grid-cols-5 gap-12">
    <div class="lg:col-span-2" data-aos="fade-up">
      <span class="text-eyebrow text-vacrc-blue-600 font-montserrat font-bold text-[0.99rem] text-justify">Contacto</span>
      <h2 class="text-h2 mt-3 text-metal">Hablemos de tu proyecto</h2>
      <p class="text-lead mt-4 text-vacrc-ink-500 font-montserrat font-medium text-[1.056rem] sm:text-[1.188rem] leading-normal text-justify">
        Cuéntanos qué necesitas y te enviamos una propuesta técnica sin costo.
      </p>

      <ul class="mt-9 space-y-5 font-montserrat font-normal text-[1.056rem] sm:text-[1.188rem]">
        <li class="group relative flex items-center gap-3 text-vacrc-ink-700">
          <span class="w-10 h-10 rounded-full bg-vacrc-ink-50 border border-vacrc-ink-100 flex items-center justify-center text-vacrc-blue-500 shrink-0">
            <Icon icon="phone" class="w-4 h-4" />
          </span>
          <a href={`tel:${SITE.phone.replace(/\s+/g, "")}`} class="cursor-pointer hover:text-vacrc-blue-600 transition-colors">{SITE.phone}</a>
          <button
            type="button"
            data-copy={SITE.phone}
            aria-label="Copiar teléfono"
            class="copy-btn cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity text-vacrc-ink-400 hover:text-vacrc-blue-600"
          >
            <Icon icon="copy" class="w-4 h-4" />
          </button>
        </li>
        <li class="group relative flex items-center gap-3 text-vacrc-ink-700">
          <span class="w-10 h-10 rounded-full bg-vacrc-ink-50 border border-vacrc-ink-100 flex items-center justify-center text-vacrc-blue-500 shrink-0">
            <Icon icon="email" class="w-4 h-4" />
          </span>
          <a id="contact-email-link" href={`mailto:${SITE.email}`} class="cursor-pointer hover:text-vacrc-blue-600 transition-colors">{SITE.email}</a>
          <button
            type="button"
            data-copy={SITE.email}
            aria-label="Copiar correo"
            class="copy-btn cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity text-vacrc-ink-400 hover:text-vacrc-blue-600"
          >
            <Icon icon="copy" class="w-4 h-4" />
          </button>
        </li>
        <li class="flex items-center gap-3 text-vacrc-ink-700">
          <span class="w-10 h-10 rounded-full bg-vacrc-ink-50 border border-vacrc-ink-100 flex items-center justify-center text-vacrc-blue-500 shrink-0">
            <Icon icon="location" class="w-4 h-4" />
          </span>
          {SITE.address}
        </li>
      </ul>
    </div>

    <form
      id="contact-form"
      class="lg:col-span-3 rounded-3xl border border-vacrc-ink-100 bg-vacrc-bg-soft p-6 sm:p-8 grid grid-cols-1 sm:grid-cols-2 gap-5 shadow-sm shadow-vacrc-ink-900/[0.03]"
      data-aos="fade-up"
      data-aos-delay="600"
    >
      <div class="sm:col-span-1">
        <label class="text-form-label block text-vacrc-ink-400 mb-2 font-montserrat">Nombre</label>
        <div class="relative">
          <input id="contact-nombre" type="text" name="nombre" required placeholder="Tu nombre" class="peer w-full rounded-lg bg-white border border-vacrc-ink-200 px-4 py-3 pr-10 font-montserrat text-[0.95rem] text-vacrc-ink-900 placeholder:text-vacrc-ink-300 focus:outline-none focus:border-vacrc-blue-500 transition-colors [&:user-valid]:border-emerald-500 [&:user-invalid]:border-red-400" />
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-emerald-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-red-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>
      </div>
      <div class="sm:col-span-1">
        <label class="text-form-label block text-vacrc-ink-400 mb-2 font-montserrat">Teléfono</label>
        <div class="relative">
          <input
            id="contact-telefono"
            type="tel"
            name="telefono"
            required
            inputmode="tel"
            pattern="[0-9+\-\s\(\)]{7,20}"
            title="Ingresa un teléfono válido (solo números, espacios, +, - o paréntesis)"
            placeholder="999 000 0000"
            class="peer w-full rounded-lg bg-white border border-vacrc-ink-200 px-4 py-3 pr-10 font-montserrat text-[0.95rem] text-vacrc-ink-900 placeholder:text-vacrc-ink-300 focus:outline-none focus:border-vacrc-blue-500 transition-colors [&:user-valid]:border-emerald-500 [&:user-invalid]:border-red-400"
          />
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-emerald-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-red-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>
      </div>
      <div class="sm:col-span-2">
        <label class="text-form-label block text-vacrc-ink-400 mb-2 font-montserrat">Servicio de interés</label>
        <select id="contact-servicio" name="servicio" class="w-full rounded-lg bg-white border border-vacrc-ink-200 px-4 py-3 font-montserrat text-[0.95rem] text-vacrc-ink-900 focus:outline-none focus:border-vacrc-blue-500 transition-colors">
          <option selected>Cotización de Proyectos</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="text-form-label block text-vacrc-ink-400 mb-2 font-montserrat">Mensaje</label>
        <div class="relative">
          <textarea id="contact-mensaje" name="mensaje" rows="4" required placeholder="Cuéntanos sobre tu proyecto..." class="peer w-full rounded-lg bg-white border border-vacrc-ink-200 px-4 py-3 pr-10 font-montserrat text-[0.95rem] text-vacrc-ink-900 placeholder:text-vacrc-ink-300 focus:outline-none focus:border-vacrc-blue-500 transition-colors resize-none [&:user-valid]:border-emerald-500 [&:user-invalid]:border-red-400"></textarea>
          <span class="hidden peer-[&:user-valid]:flex absolute right-3 top-3 pointer-events-none text-emerald-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="hidden peer-[&:user-invalid]:flex absolute right-3 top-3 pointer-events-none text-red-500">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L14 14M14 6L6 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </div>
      </div>

      <div class="sm:col-span-2">
        <label class="text-form-label block text-vacrc-ink-400 mb-2 font-montserrat">Código de seguridad</label>
        <div class="flex items-center gap-3">
          <div class="relative h-12 w-32 shrink-0 rounded-lg border border-vacrc-ink-200 bg-vacrc-ink-50 overflow-hidden flex items-center justify-center">
            <span id="captcha-placeholder" class="text-vacrc-ink-300">
              <Icon icon="shield" class="w-5 h-5" />
            </span>
            <img id="captcha-image" alt="Código de verificación" class="absolute inset-0 w-full h-full object-contain hidden transition-opacity" />
          </div>
          <button
            type="button"
            id="captcha-refresh"
            aria-label="Generar nuevo código"
            class="shrink-0 w-10 h-10 rounded-lg border border-vacrc-ink-200 flex items-center justify-center text-vacrc-ink-400 hover:text-vacrc-blue-600 hover:border-vacrc-blue-500 transition-colors cursor-pointer"
          >
            <Icon icon="refresh" class="w-4 h-4" />
          </button>
          <input
            id="contact-captcha"
            type="text"
            name="captcha_code"
            required
            autocomplete="off"
            placeholder="Escribe el código"
            class="flex-1 min-w-0 rounded-lg bg-white border border-vacrc-ink-200 px-4 py-3 font-montserrat text-[0.95rem] text-vacrc-ink-900 placeholder:text-vacrc-ink-300 focus:outline-none focus:border-vacrc-blue-500 transition-colors"
          />
        </div>
      </div>

      <Button id="send-email" type="button" variant="secondary" icon="email" iconPosition="left" class="sm:col-span-1 mt-1">
        Enviar correo
      </Button>
      <Button id="send-whatsapp" type="button" icon="phone" iconPosition="left" class="sm:col-span-1 mt-1">
        Enviar WhatsApp
      </Button>
    </form>
  </div>
</section>

<style is:global>
  .toastify {
    font-family: var(--font-montserrat);
    font-size: 0.9rem;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    box-shadow: 0 10px 25px -5px rgba(14, 30, 51, 0.25);
  }
  .toastify.toast-success {
    background: var(--color-emerald-600, #059669);
  }
  .toastify.toast-error {
    background: var(--color-red-600, #dc2626);
  }
</style>

<script>
  import Toastify from "toastify-js";
  window.Toastify = Toastify;
</script>

<script define:vars={{ email: SITE.email, whatsapp: SOCIAL.whatsapp, apiUrl: CONTACT_API_URL, captchaApiUrl: CAPTCHA_API_URL, apiKey: CONTACT_API_KEY }}>
  const form = document.getElementById("contact-form");
  const nombreEl = document.getElementById("contact-nombre");
  const telefonoEl = document.getElementById("contact-telefono");
  const servicioEl = document.getElementById("contact-servicio");
  const mensajeEl = document.getElementById("contact-mensaje");
  const captchaCodeEl = document.getElementById("contact-captcha");
  const captchaImageEl = document.getElementById("captcha-image");
  const captchaPlaceholderEl = document.getElementById("captcha-placeholder");
  const captchaRefreshBtn = document.getElementById("captcha-refresh");
  const sendEmailBtn = document.getElementById("send-email");

  let captchaUuid = null;
  let captchaExpireTimer = null;

  const showCaptchaPlaceholder = () => {
    captchaImageEl.classList.add("hidden");
    captchaImageEl.removeAttribute("src");
    captchaPlaceholderEl.classList.remove("hidden");
  };

  const loadCaptcha = async () => {
    window.clearTimeout(captchaExpireTimer);
    captchaImageEl.classList.add("opacity-40");
    captchaCodeEl.value = "";
    try {
      const res = await fetch(captchaApiUrl, {
        headers: { "X-API-Token": apiKey },
      });
      if (!res.ok) throw new Error(`Captcha request failed with status ${res.status}`);
      const json = await res.json();
      const { uuid, image, expire_seconds } = json.data;
      captchaUuid = uuid;
      captchaImageEl.src = `data:image/jpeg;base64,${image}`;
      captchaImageEl.classList.remove("hidden");
      captchaPlaceholderEl.classList.add("hidden");
      captchaExpireTimer = window.setTimeout(loadCaptcha, (expire_seconds || 300) * 1000);
    } catch (err) {
      captchaUuid = null;
      showCaptchaPlaceholder();
    } finally {
      captchaImageEl.classList.remove("opacity-40");
    }
  };

  captchaRefreshBtn?.addEventListener("click", loadCaptcha);
  loadCaptcha();

  const getValues = () => ({
    nombre: nombreEl.value.trim(),
    telefono: telefonoEl.value.trim(),
    servicio: servicioEl.value,
    mensaje: mensajeEl.value.trim(),
  });

  // Only allow phone-appropriate characters as the user types.
  telefonoEl.addEventListener("input", () => {
    telefonoEl.value = telefonoEl.value.replace(/[^0-9+\-\s()]/g, "");
  });

  const showStatus = (message, isError) => {
    window.Toastify({
      text: message,
      duration: isError ? 7000 : 6000,
      close: true,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      className: isError ? "toast-error" : "toast-success",
    }).showToast();
  };

  const mailtoFallback = (e) => {
    e?.preventDefault();
    const { nombre, telefono, servicio, mensaje } = getValues();
    const subject = `Solicitud de cotización - ${servicio}`;
    const body =
      `Nombre: ${nombre}\n` +
      `Teléfono: ${telefono}\n` +
      `Servicio de interés: ${servicio}\n\n` +
      `Mensaje:\n${mensaje}`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  const sendEmailBtnDefaultHTML = sendEmailBtn.innerHTML;
  const SEND_SPINNER_HTML =
    '<svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
    '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
    '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>' +
    "</svg><span>Enviando...</span>";
  const SEND_SUCCESS_HTML =
    '<svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">' +
    '<path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>' +
    "<span>Enviado</span>";

  const sendEmailApi = async (e) => {
    e?.preventDefault();

    if (sendEmailBtn.disabled) return;

    if (
      !nombreEl.value.trim() ||
      !telefonoEl.value.trim() ||
      !mensajeEl.value.trim() ||
      !captchaCodeEl.value.trim() ||
      !form.checkValidity()
    ) {
      form.reportValidity();
      return;
    }

    if (!captchaUuid) {
      showStatus("No pudimos cargar el código de seguridad. Intenta de nuevo.", true);
      loadCaptcha();
      return;
    }

    const { nombre, telefono, servicio, mensaje } = getValues();
    const captcha_uuid = captchaUuid;
    const captcha_code = captchaCodeEl.value.trim();
    sendEmailBtn.disabled = true;
    sendEmailBtn.classList.add("opacity-60", "cursor-not-allowed");
    sendEmailBtn.innerHTML = SEND_SPINNER_HTML;

    try {
      const res = await fetch(apiUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-API-Token": apiKey,
        },
        body: JSON.stringify({ nombre, telefono, servicio, mensaje, captcha_uuid, captcha_code }),
      });

      if (!res.ok) throw new Error(`Request failed with status ${res.status}`);

      showStatus("¡Listo! Tu solicitud fue enviada correctamente.", false);
      form.reset();
      sendEmailBtn.innerHTML = SEND_SUCCESS_HTML;
      loadCaptcha();
      window.setTimeout(() => {
        sendEmailBtn.disabled = false;
        sendEmailBtn.classList.remove("opacity-60", "cursor-not-allowed");
        sendEmailBtn.innerHTML = sendEmailBtnDefaultHTML;
      }, 3000);
    } catch (err) {
      showStatus("No pudimos enviar tu solicitud. Verifica el código de seguridad e intenta de nuevo.", true);
      sendEmailBtn.disabled = false;
      sendEmailBtn.classList.remove("opacity-60", "cursor-not-allowed");
      sendEmailBtn.innerHTML = sendEmailBtnDefaultHTML;
      loadCaptcha();
    }
  };

  sendEmailBtn?.addEventListener("click", sendEmailApi);
  document.getElementById("contact-email-link")?.addEventListener("click", mailtoFallback);

  document.getElementById("send-whatsapp")?.addEventListener("click", () => {
    const { nombre, telefono, mensaje } = getValues();
    const text =
      `Hola, soy ${nombre || "un cliente interesado"}.\n` +
      `Teléfono: ${telefono || "no proporcionado"}.\n` +
      `Mensaje: ${mensaje || "Quiero más información sobre sus proyectos de climatización."}`;
    window.open(`${whatsapp}?text=${encodeURIComponent(text)}`, "_blank");
  });

  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const value = btn.getAttribute("data-copy");
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        return;
      }
      const original = btn.innerHTML;
      btn.innerHTML = '<svg viewBox="0 0 20 20" fill="none" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>';
      btn.classList.add("text-emerald-500");
      window.setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove("text-emerald-500");
      }, 1500);
    });
  });
</script>
