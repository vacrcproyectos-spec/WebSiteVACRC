---
import { NAV_LINKS, SITE, SOCIAL } from "../data/site";
import Button from "./Button.astro";
import SocialIcon from "./SocialIcon.astro";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 ease-out">
  <div id="navbar-shell" class="transition-all duration-300 border-b border-transparent bg-transparent">
    <nav class="max-w-7xl mx-auto px-5 sm:px-8 flex items-center justify-between h-16 md:h-20">

      <!-- Brand Logo -->
      <a href="#inicio" class="flex items-center h-9 md:h-10 group">
        <img
            src="/logo.svg"
            alt={SITE.name}
            class="h-7 md:h-8 w-auto object-contain brightness-200 contrast-200 transition-transform duration-300 group-hover:scale-105"
        />
      </a>

      <!-- Desktop Links -->
      <ul class="hidden lg:flex items-center gap-8">
        {NAV_LINKS.map((link) => (
            <li>
              <a
                  href={link.href}
                  class="navbar-link relative py-2 font-montserrat text-[0.75rem] uppercase tracking-[0.2em] text-white/70 hover:text-white transition-colors after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0 after:bg-vacrc-cyan-400 hover:after:w-full after:transition-all after:duration-300"
              >
                {link.label}
              </a>
            </li>
        ))}
      </ul>

      <!-- Social Media Icons -->
      <div class="hidden lg:flex items-center gap-2">
        <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de VACRC"
            class="social-icon group w-9 h-9 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/facebook.png" alt="Facebook" class="w-3.5 h-3.5 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
        <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de VACRC"
            class="social-icon group w-9 h-9 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/instagram.png" alt="Instagram" class="w-3.5 h-3.5 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
        <a
            href={SOCIAL.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de VACRC"
            class="social-icon group w-9 h-9 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/whatsapp.png" alt="WhatsApp" class="w-3.5 h-3.5 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
      </div>

      <!-- Action Button -->
      <div class="hidden lg:block">
        <Button href="#contacto" size="sm">
          Cotizar servicio
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
          id="menu-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="lg:hidden relative w-10 h-10 border border-white/15 bg-white/[0.03] flex items-center justify-center text-white transition-colors duration-300 cursor-pointer hover:border-vacrc-cyan-400"
      >
        <span class="sr-only">Menú</span>
        <div class="w-5 flex flex-col gap-1.5">
          <span id="bar1" class="block h-0.5 bg-current transition-all duration-300 origin-center"></span>
          <span id="bar2" class="block h-0.5 bg-current transition-all duration-300"></span>
          <span id="bar3" class="block h-0.5 bg-current transition-all duration-300 origin-center"></span>
        </div>
      </button>

    </nav>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
      id="mobile-menu"
      class="lg:hidden max-h-0 overflow-hidden transition-[max-height] duration-500 ease-out bg-black/90 backdrop-blur-xl border-b border-white/10"
  >
    <ul class="flex flex-col px-6 py-6 gap-2 font-montserrat">
      {NAV_LINKS.map((link) => (
          <li>
            <a
                href={link.href}
                class="mobile-link navbar-link block py-3 border-b border-white/10 text-white/80 hover:text-vacrc-cyan-400 text-center text-xs uppercase tracking-[0.25em] transition-colors"
            >
              {link.label}
            </a>
          </li>
      ))}
      <li class="pt-4">
        <Button href="#contacto" size="sm" class="mobile-link w-full">
          Cotizar servicio
        </Button>
      </li>
      <li class="flex items-center justify-center gap-3 pt-6">
        <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de VACRC"
            class="group w-10 h-10 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/facebook.png" alt="Facebook" class="w-4 h-4 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
        <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de VACRC"
            class="group w-10 h-10 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/instagram.png" alt="Instagram" class="w-4 h-4 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
        <a
            href={SOCIAL.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de VACRC"
            class="group w-10 h-10 border border-white/10 bg-white/[0.03] flex items-center justify-center text-white/70 hover:text-vacrc-cyan-400 hover:border-vacrc-cyan-400/50 hover:bg-vacrc-cyan-400/5 transition-all duration-300"
        >
          <SocialIcon src="/brands/whatsapp.png" alt="WhatsApp" class="w-4 h-4 brightness-200 opacity-70 group-hover:opacity-100 transition-opacity" />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const shell = document.getElementById("navbar-shell");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");

  let menuOpen = false;

  const HIDE_THRESHOLD = 80;
  let lastScrollY = window.scrollY;
  let headerHidden = false;

  const setHeaderVisibility = () => {
    if (!header || menuOpen) return;
    const currentY = window.scrollY;
    const scrollingDown = currentY > lastScrollY;

    if (scrollingDown && currentY > HIDE_THRESHOLD && !headerHidden) {
      headerHidden = true;
      header.style.transform = "translateY(-100%)";
    } else if ((!scrollingDown || currentY <= HIDE_THRESHOLD) && headerHidden) {
      headerHidden = false;
      header.style.transform = "translateY(0)";
    }
    lastScrollY = currentY;
  };

  const setScrolled = () => {
    if (!shell) return;
    const scrolled = window.scrollY > 20 || menuOpen;

    if (scrolled) {
      shell.classList.add("bg-black/80", "backdrop-blur-md", "border-white/10");
      shell.classList.remove("bg-transparent", "border-transparent");
    } else {
      shell.classList.add("bg-transparent", "border-transparent");
      shell.classList.remove("bg-black/80", "backdrop-blur-md", "border-white/10");
    }
  };

  setScrolled();
  setHeaderVisibility();

  window.addEventListener("scroll", () => {
    setScrolled();
    setHeaderVisibility();
  }, { passive: true });

  window.addEventListener("resize", setScrolled);

  const setMenu = (state: boolean) => {
    menuOpen = state;
    toggle?.setAttribute("aria-expanded", String(menuOpen));
    if (menuOpen && header) {
      headerHidden = false;
      header.style.transform = "translateY(0)";
    }

    setScrolled();

    if (!menu) return;
    menu.style.maxHeight = menuOpen ? menu.scrollHeight + "px" : "0px";
    bar1?.classList.toggle("rotate-45", menuOpen);
    bar1?.classList.toggle("translate-y-2", menuOpen);
    bar2?.classList.toggle("opacity-0", menuOpen);
    bar3?.classList.toggle("-rotate-45", menuOpen);
    bar3?.classList.toggle("-translate-y-2", menuOpen);
  };

  toggle?.addEventListener("click", () => setMenu(!menuOpen));
  document.querySelectorAll(".mobile-link").forEach((el) =>
      el.addEventListener("click", () => setMenu(false))
  );
</script>
