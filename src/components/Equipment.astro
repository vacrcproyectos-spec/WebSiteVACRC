---
import { EQUIPMENT } from "../data/site";
import Icon from "./Icon.astro";
import SectionDivider from "./SectionDivider.astro";

const chunkSize = 4;
const rows = Array.from({ length: Math.ceil(EQUIPMENT.length / chunkSize) }, (_, i) =>
  EQUIPMENT.slice(i * chunkSize, i * chunkSize + chunkSize)
);
---

<section id="equipos" class="relative py-24 md:py-32 bg-white border-t border-vacrc-ink-100">
  <SectionDivider />
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <span class="font-mono text-xs uppercase tracking-widest text-vacrc-blue-600">Equipos con los que trabajamos</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl mt-3 text-metal">
        Tecnología para cada tipo de proyecto
      </h2>
      <p class="mt-4 text-vacrc-ink-500 text-base sm:text-lg">
        Desde una habitación hasta un edificio completo, seleccionamos el tipo de minisplit correcto para cada espacio y presupuesto. Pasa el cursor sobre cada uno para verlo de cerca.
      </p>
    </div>

    <div class="mt-14 md:mt-16 space-y-3">
      {rows.map((row, rowIndex) => (
        <div class:list={["reveal flex flex-col md:flex-row gap-3 md:h-[420px]", `reveal-delay-${Math.min(rowIndex + 1, 4)}`]}>
          {row.map((item) => (
            <div class="group relative w-full h-64 md:h-full md:flex-1 md:min-w-0 overflow-hidden rounded-2xl bg-vacrc-ink-900 cursor-pointer md:transition-[flex-grow] md:duration-700 md:ease-out md:hover:flex-[2.5]">
              <img
                src={`/equipos/${item.slug}.png`}
                onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
                alt={item.name}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-vacrc-ink-900/90 via-vacrc-ink-900/25 to-transparent"></div>

              <div class="absolute inset-x-0 bottom-0 p-5">
                <div class="w-10 h-10 rounded-lg bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-white">
                  <Icon icon={item.icon} class="w-5 h-5" />
                </div>
                <h3 class="font-display font-bold text-lg text-white mt-3 leading-tight">{item.name}</h3>
                <p class="mt-2 text-sm text-white/80 leading-relaxed max-h-32 opacity-100 overflow-hidden transition-all duration-500 md:max-h-0 md:opacity-0 md:group-hover:max-h-32 md:group-hover:opacity-100">
                  {item.short}
                </p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
