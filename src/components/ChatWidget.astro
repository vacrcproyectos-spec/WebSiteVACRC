---
import { SITE } from "../data/site";
import Icon from "./Icon.astro";
import faq from "../../preguntas-respuestas-vacrc.json";
---

<div id="chat-widget" class="fixed bottom-5 right-5 sm:bottom-7 sm:right-7 z-[70]">
  <!-- Panel -->
  <div
    id="chat-panel"
    class="chat-panel absolute bottom-[4.75rem] right-0 flex flex-col rounded-[20px] bg-white shadow-2xl shadow-vacrc-ink-900/25 overflow-hidden origin-bottom-right opacity-0 scale-95 translate-y-2 pointer-events-none"
  >
    <div class="shrink-0 bg-vacrc-blue-500 text-white px-3.5 py-3 flex items-center gap-2.5">
      <span class="relative w-11 h-9 rounded-2xl bg-white/15 border border-white/20 flex items-center justify-center shrink-0">
        <svg viewBox="0 0 82 68" class="w-9 h-7" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="botShellHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#FFFFFF" />
              <stop offset="1" stop-color="#DCEDF0" />
            </linearGradient>
            <linearGradient id="botFaceHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1C3F5E" />
              <stop offset="1" stop-color="#0A1C2E" />
            </linearGradient>
            <radialGradient id="botGlowHead" cx="35%" cy="30%" r="75%">
              <stop offset="0" stop-color="#B7F0E4" />
              <stop offset="1" stop-color="#2E86AB" />
            </radialGradient>
          </defs>

          <path d="M15 24C10 25 10 29 15 30" stroke="#0F2E4F" stroke-width="1.7" stroke-linecap="round" opacity="0.55" />
          <path d="M65 24C70 25 70 29 65 30" stroke="#0F2E4F" stroke-width="1.7" stroke-linecap="round" opacity="0.55" />

          <path d="M14 34C6 37 3 44 6 49" stroke="url(#botFaceHead)" stroke-width="2" stroke-linecap="round" />
          <rect x="1" y="47" width="8" height="6" rx="3" fill="url(#botFaceHead)" />
          <path d="M66 34C74 37 77 44 74 49" stroke="url(#botFaceHead)" stroke-width="2" stroke-linecap="round" />
          <rect x="71" y="47" width="8" height="6" rx="3" fill="url(#botFaceHead)" />

          <path d="M40 6V14" stroke="#0F2E4F" stroke-width="1.8" stroke-linecap="round" />
          <circle cx="40" cy="4.5" r="2.8" fill="url(#botGlowHead)" />

          <rect x="14" y="14" width="52" height="34" rx="15" fill="url(#botShellHead)" stroke="#0F2E4F" stroke-width="1.8" />
          <path d="M20 16.5C29 12.5 51 12.5 59 16.5" stroke="white" stroke-width="1.4" stroke-linecap="round" opacity="0.6" />

          <rect x="21" y="20" width="38" height="19" rx="8" fill="url(#botFaceHead)" />
          <rect x="28" y="26" width="8" height="6" rx="3" fill="url(#botGlowHead)" />
          <rect x="44" y="26" width="8" height="6" rx="3" fill="url(#botGlowHead)" />
          <circle cx="30.5" cy="27.5" r="0.9" fill="white" opacity="0.9" />
          <circle cx="46.5" cy="27.5" r="0.9" fill="white" opacity="0.9" />

          <path d="M26 42.5H54" stroke="#0F2E4F" stroke-width="1.7" stroke-linecap="round" opacity="0.4" />
          <path d="M29 45.5H51" stroke="#0F2E4F" stroke-width="1.7" stroke-linecap="round" opacity="0.25" />

          <rect x="28" y="48" width="10" height="7" rx="3.5" fill="url(#botFaceHead)" />
          <rect x="44" y="48" width="10" height="7" rx="3.5" fill="url(#botFaceHead)" />
        </svg>
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-vacrc-blue-500"></span>
      </span>
      <div class="min-w-0 leading-tight">
        <p class="font-display font-bold text-sm">Asistente VACRC</p>
        <p class="text-[11px] text-white/75">En línea</p>
      </div>
      <div class="ml-auto flex items-center gap-0.5 shrink-0">
        <button
          type="button"
          id="chat-close"
          aria-label="Cerrar chat"
          class="w-7 h-7 rounded-full flex items-center justify-center text-white/80 hover:text-white hover:bg-white/10 transition-colors"
        >
          <Icon icon="arrow" class="w-3.5 h-3.5 rotate-45" />
        </button>
      </div>
    </div>

    <!-- Manual resize handles: drag the top/left edges or the corner to resize -->
    <div id="chat-resize-corner" class="chat-resize-handle chat-resize-corner" aria-hidden="true">
      <svg viewBox="0 0 10 10" class="w-2.5 h-2.5" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8.5 1.5L1.5 8.5M8.5 5L5 8.5" stroke="white" stroke-opacity="0.85" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </div>
    <div id="chat-resize-top" class="chat-resize-handle chat-resize-top" aria-hidden="true"></div>
    <div id="chat-resize-left" class="chat-resize-handle chat-resize-left" aria-hidden="true"></div>

    <div id="chat-messages" class="flex-1 min-h-0 overflow-y-auto bg-vacrc-bg-soft px-3 py-3.5 flex flex-col gap-2"></div>

    <div class="chat-suggestions shrink-0 bg-white border-t border-vacrc-ink-100" id="chat-suggestions">
      <div class="flex gap-1.5 px-2.5 py-1.5 overflow-x-auto whitespace-nowrap">
        <button type="button" class="chat-suggestion shrink-0 text-[10.5px] leading-none px-2 py-1 rounded-full border border-vacrc-ink-200 text-vacrc-ink-500 hover:border-vacrc-blue-500 hover:text-vacrc-blue-600 transition-colors">Alcances</button>
        <button type="button" class="chat-suggestion shrink-0 text-[10.5px] leading-none px-2 py-1 rounded-full border border-vacrc-ink-200 text-vacrc-ink-500 hover:border-vacrc-blue-500 hover:text-vacrc-blue-600 transition-colors">Horario</button>
        <button type="button" class="chat-suggestion shrink-0 text-[10.5px] leading-none px-2 py-1 rounded-full border border-vacrc-ink-200 text-vacrc-ink-500 hover:border-vacrc-blue-500 hover:text-vacrc-blue-600 transition-colors">Cotización</button>
        <button type="button" class="chat-suggestion shrink-0 text-[10.5px] leading-none px-2 py-1 rounded-full border border-vacrc-ink-200 text-vacrc-ink-500 hover:border-vacrc-blue-500 hover:text-vacrc-blue-600 transition-colors">Marcas</button>
      </div>
    </div>

    <form id="chat-form" class="shrink-0 bg-white border-t border-vacrc-ink-100 p-2 flex items-center gap-1.5">
      <input
        id="chat-input"
        type="text"
        autocomplete="off"
        placeholder="Escribe tu pregunta..."
        class="flex-1 min-w-0 rounded-full bg-vacrc-ink-50 border border-vacrc-ink-100 px-3.5 py-2 text-sm text-vacrc-ink-900 placeholder:text-vacrc-ink-300 focus:outline-none focus:border-vacrc-blue-500 transition-colors"
      />
      <button
        type="submit"
        aria-label="Enviar pregunta"
        class="shrink-0 w-9 h-9 rounded-full bg-vacrc-blue-500 hover:bg-vacrc-blue-600 text-white flex items-center justify-center transition-colors"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 -translate-x-px" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 20L21 12L3 4L3 10.5L15 12L3 13.5L3 20Z" />
        </svg>
      </button>
    </form>
  </div>

  <!-- Floating button: a small robot whose body is a minisplit unit -->
  <button
    type="button"
    id="chat-toggle"
    aria-label="Abrir chat de VACRC"
    aria-expanded="false"
    class="chat-fab relative w-20 h-16 sm:w-24 sm:h-20 flex items-end justify-center bg-transparent"
  >
    <span class="chat-fab-shadow absolute bottom-0 w-11 h-3 rounded-full bg-vacrc-ink-900/40 blur-[3px]"></span>
    <svg
      viewBox="0 0 82 68"
      class="chat-fab-bot relative w-full h-full drop-shadow-[0_6px_8px_rgba(14,30,51,0.3)]"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="botShellFab" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FFFFFF" />
          <stop offset="1" stop-color="#DCEDF0" />
        </linearGradient>
        <linearGradient id="botFaceFab" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1C3F5E" />
          <stop offset="1" stop-color="#0A1C2E" />
        </linearGradient>
        <radialGradient id="botGlowFab" cx="35%" cy="30%" r="75%">
          <stop offset="0" stop-color="#B7F0E4" />
          <stop offset="1" stop-color="#2E86AB" />
        </radialGradient>
      </defs>

      <!-- ear vents -->
      <path d="M15 24C10 25 10 29 15 30" stroke="#0F2E4F" stroke-width="2" stroke-linecap="round" opacity="0.55" />
      <path d="M65 24C70 25 70 29 65 30" stroke="#0F2E4F" stroke-width="2" stroke-linecap="round" opacity="0.55" />

      <!-- arms -->
      <path d="M14 34C6 37 3 44 6 49" stroke="url(#botFaceFab)" stroke-width="2.2" stroke-linecap="round" />
      <rect x="1" y="47" width="9" height="7" rx="3.5" fill="url(#botFaceFab)" />
      <path d="M66 34C74 37 77 44 74 49" stroke="url(#botFaceFab)" stroke-width="2.2" stroke-linecap="round" />
      <rect x="70" y="47" width="9" height="7" rx="3.5" fill="url(#botFaceFab)" />

      <!-- antenna -->
      <path d="M40 6V14" stroke="#0F2E4F" stroke-width="2" stroke-linecap="round" />
      <circle cx="40" cy="4.5" r="3.2" fill="url(#botGlowFab)" />

      <!-- shell -->
      <rect x="14" y="14" width="52" height="34" rx="15" fill="url(#botShellFab)" stroke="#0F2E4F" stroke-width="2" />
      <path d="M20 16.5C29 12.5 51 12.5 59 16.5" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity="0.6" />

      <!-- face panel -->
      <rect x="21" y="20" width="38" height="19" rx="8" fill="url(#botFaceFab)" />
      <rect x="28" y="26" width="8" height="6" rx="3" fill="url(#botGlowFab)" />
      <rect x="44" y="26" width="8" height="6" rx="3" fill="url(#botGlowFab)" />
      <circle cx="30.5" cy="27.5" r="1" fill="white" opacity="0.9" />
      <circle cx="46.5" cy="27.5" r="1" fill="white" opacity="0.9" />

      <!-- vent grille -->
      <path d="M26 42.5H54" stroke="#0F2E4F" stroke-width="2" stroke-linecap="round" opacity="0.4" />
      <path d="M29 45.5H51" stroke="#0F2E4F" stroke-width="2" stroke-linecap="round" opacity="0.25" />

      <!-- feet -->
      <rect x="28" y="48" width="10" height="7" rx="3.5" fill="url(#botFaceFab)" />
      <rect x="44" y="48" width="10" height="7" rx="3.5" fill="url(#botFaceFab)" />
    </svg>
  </button>
</div>

<style is:global>
  .chat-panel {
    width: min(26rem, calc(100vw - 2.5rem));
    height: min(40rem, 80vh);
    min-width: 300px;
    min-height: 360px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .chat-panel.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .chat-panel.is-resizing {
    transition: none !important;
    user-select: none;
  }

  .chat-resize-handle {
    position: absolute;
    z-index: 20;
  }
  .chat-resize-top {
    top: 0;
    left: 14px;
    right: 0;
    height: 6px;
    cursor: ns-resize;
  }
  .chat-resize-left {
    top: 14px;
    left: 0;
    bottom: 0;
    width: 6px;
    cursor: ew-resize;
  }
  .chat-resize-corner {
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    cursor: nwse-resize;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 2px;
    opacity: 0.7;
  }
  .chat-resize-corner:hover {
    opacity: 1;
  }

  .chat-suggestions {
    max-height: 3rem;
    overflow: hidden;
    transition: max-height 0.25s ease, opacity 0.2s ease;
  }
  .chat-suggestions.is-hidden {
    max-height: 0;
    opacity: 0;
  }

  .chat-bubble {
    position: relative;
    max-width: 80%;
    font-size: 0.85rem;
    line-height: 1.4;
    padding: 0.4rem 0.65rem;
    border-radius: 0.55rem;
  }
  .chat-bubble .chat-text {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .chat-bubble .chat-time {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    float: right;
    margin: 0.2rem 0 -0.1rem 0.5rem;
    font-size: 0.62rem;
    line-height: 1;
  }
  .chat-ticks {
    display: inline-flex;
    line-height: 0;
  }
  .chat-bubble.bot {
    align-self: flex-start;
    background: white;
    color: var(--color-vacrc-ink-700);
    box-shadow: 0 1px 1.5px rgba(14, 30, 51, 0.1);
    border-top-left-radius: 0.15rem;
  }
  .chat-bubble.bot .chat-time {
    color: var(--color-vacrc-ink-300);
  }
  .chat-bubble.bot::before {
    content: "";
    position: absolute;
    top: 0;
    left: -6px;
    width: 10px;
    height: 11px;
    background: white;
    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }
  .chat-bubble.user {
    align-self: flex-end;
    background: var(--color-vacrc-blue-500);
    color: white;
    border-top-right-radius: 0.15rem;
  }
  .chat-bubble.user .chat-time {
    color: rgba(255, 255, 255, 0.7);
  }
  .chat-bubble.user::before {
    content: "";
    position: absolute;
    top: 0;
    right: -6px;
    width: 10px;
    height: 11px;
    background: var(--color-vacrc-blue-500);
    clip-path: polygon(0 0, 0 100%, 100% 0);
  }
  .chat-typing {
    align-self: flex-start;
    display: flex;
    gap: 3px;
    padding: 0.55rem 0.75rem;
    background: white;
    box-shadow: 0 1px 1.5px rgba(14, 30, 51, 0.1);
    border-radius: 0.55rem;
    border-top-left-radius: 0.15rem;
  }
  .chat-typing span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-vacrc-ink-300);
    animation: chat-typing-bounce 1.1s infinite ease-in-out;
  }
  .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes chat-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-3px); opacity: 1; }
  }

  .chat-fab-bot {
    animation: chat-fab-float 3.2s ease-in-out infinite;
  }
  .chat-fab-shadow {
    animation: chat-fab-shadow-pulse 3.2s ease-in-out infinite;
  }
  .chat-fab:hover .chat-fab-bot {
    animation-play-state: paused;
    transform: translateY(-6px);
  }
  .chat-fab:hover .chat-fab-shadow {
    animation-play-state: paused;
    transform: scaleX(0.75);
    opacity: 0.25;
  }
  @keyframes chat-fab-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes chat-fab-shadow-pulse {
    0%, 100% { transform: scaleX(1); opacity: 0.4; }
    50% { transform: scaleX(0.7); opacity: 0.2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-typing span { animation: none; opacity: 0.8; }
    .chat-fab-bot, .chat-fab-shadow { animation: none !important; }
    .chat-panel { transition: none !important; }
    .chat-suggestions { transition: none !important; }
  }
</style>

<script define:vars={{ faq, phone: SITE.phone }}>
  const STOPWORDS = new Set([
    "que", "cual", "cuales", "como", "para", "por", "con", "los", "las", "una", "uno",
    "del", "las", "sus", "sobre", "esta", "este", "estos", "estas", "hay", "muy",
    "puedo", "puede", "pueden", "tiene", "tienen", "hacer", "hacen", "dan", "sera",
    "soy", "eres", "somos", "son", "van", "voy", "tengo", "algun", "alguna", "algo",
    "the", "and", "for",
  ]);

  const normalize = (str) =>
    str
      .toLowerCase()
      .normalize("NFD")
      .replace(new RegExp("[\\u0300-\\u036f]", "g"), "")
      .replace(/[¿?¡!.,;:()"']/g, "")
      .trim();

  const tokenize = (str) =>
    normalize(str)
      .split(/\s+/)
      .filter((w) => w.length > 2 && !STOPWORDS.has(w));

  const corpus = faq.map((item) => ({
    ...item,
    tokens: tokenize(item.instruction),
  }));

  const scoreMatch = (queryTokens, itemTokens) => {
    if (queryTokens.length === 0 || itemTokens.length === 0) return 0;
    const shared = itemTokens.filter((t) => queryTokens.includes(t)).length;
    return (2 * shared) / (queryTokens.length + itemTokens.length);
  };

  const findAnswer = (question) => {
    const normalized = normalize(question);

    if (/^(hola|buenas|buenos dias|buenas tardes|buenas noches|hey|que tal)/.test(normalized)) {
      return "¡Hola! Soy el asistente de VACRC. Pregúntame sobre instalación, mantenimiento o reparación de tu minisplit, marcas con las que trabajamos, horarios o contacto.";
    }
    if (/gracias/.test(normalized)) {
      return "¡De nada! Si tienes otra duda sobre tu minisplit, aquí estoy.";
    }

    const queryTokens = tokenize(question);
    let best = null;
    let bestScore = 0;
    for (const item of corpus) {
      const s = scoreMatch(queryTokens, item.tokens);
      if (s > bestScore) {
        bestScore = s;
        best = item;
      }
    }

    if (best && bestScore >= 0.28) {
      return best.output;
    }

    return `No estoy seguro de haber entendido tu pregunta. Puedes preguntarme sobre instalación, mantenimiento, reparación, marcas o contacto, o comunícate directamente al ${phone}.`;
  };

  const toggleBtn = document.getElementById("chat-toggle");
  const panel = document.getElementById("chat-panel");
  const closeBtn = document.getElementById("chat-close");
  const messagesEl = document.getElementById("chat-messages");
  const suggestionsEl = document.getElementById("chat-suggestions");
  const form = document.getElementById("chat-form");
  const input = document.getElementById("chat-input");
  const resizeCorner = document.getElementById("chat-resize-corner");
  const resizeTop = document.getElementById("chat-resize-top");
  const resizeLeft = document.getElementById("chat-resize-left");

  let open = false;
  let started = false;
  let suggestionsDismissed = false;

  const formatTime = (date) =>
    date.toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit", hour12: false });

  const TICKS_SVG =
    '<svg viewBox="0 0 16 11" width="13" height="9" fill="none" xmlns="http://www.w3.org/2000/svg">' +
    '<path d="M1 5.5L4 8.5L9.5 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />' +
    '<path d="M6 5.5L9 8.5L15 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />' +
    "</svg>";

  const addBubble = (text, from) => {
    const bubble = document.createElement("div");
    bubble.className = `chat-bubble ${from}`;

    const textEl = document.createElement("span");
    textEl.className = "chat-text";
    textEl.textContent = text;

    const timeEl = document.createElement("span");
    timeEl.className = "chat-time";
    timeEl.append(formatTime(new Date()));

    if (from === "user") {
      const ticks = document.createElement("span");
      ticks.className = "chat-ticks";
      ticks.innerHTML = TICKS_SVG;
      timeEl.appendChild(ticks);
    }

    bubble.appendChild(textEl);
    bubble.appendChild(timeEl);
    messagesEl.appendChild(bubble);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  };

  const showTyping = () => {
    const typing = document.createElement("div");
    typing.className = "chat-typing";
    typing.id = "chat-typing-indicator";
    typing.innerHTML = "<span></span><span></span><span></span>";
    messagesEl.appendChild(typing);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  };

  const removeTyping = () => {
    document.getElementById("chat-typing-indicator")?.remove();
  };

  const dismissSuggestions = () => {
    if (suggestionsDismissed) return;
    suggestionsDismissed = true;
    suggestionsEl.classList.add("is-hidden");
  };

  const respond = (question) => {
    dismissSuggestions();
    addBubble(question, "user");
    showTyping();
    window.setTimeout(() => {
      removeTyping();
      addBubble(findAnswer(question), "bot");
    }, 450 + Math.random() * 350);
  };

  const setOpen = (state) => {
    open = state;
    toggleBtn.setAttribute("aria-expanded", String(open));
    toggleBtn.setAttribute("aria-label", open ? "Cerrar chat de VACRC" : "Abrir chat de VACRC");
    panel.classList.toggle("is-open", open);

    if (open && !started) {
      started = true;
      addBubble(
        "¡Hola! Soy el asistente de VACRC. Puedo ayudarte con dudas sobre instalación, mantenimiento y reparación de equipos minisplit. ¿En qué te ayudo?",
        "bot"
      );
    }
    if (open) window.setTimeout(() => input?.focus(), 300);
  };

  const MIN_WIDTH = 300;
  const MIN_HEIGHT = 360;

  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const startResize = (startEvent, axis) => {
    startEvent.preventDefault();
    const startX = startEvent.clientX;
    const startY = startEvent.clientY;
    const rect = panel.getBoundingClientRect();
    const startWidth = rect.width;
    const startHeight = rect.height;
    const maxWidth = Math.min(window.innerWidth - 40, 760);
    const maxHeight = Math.min(window.innerHeight - 40, 880);

    panel.classList.add("is-resizing");

    const onMove = (moveEvent) => {
      if (axis === "x" || axis === "both") {
        const nextWidth = clamp(startWidth + (startX - moveEvent.clientX), MIN_WIDTH, maxWidth);
        panel.style.width = `${nextWidth}px`;
      }
      if (axis === "y" || axis === "both") {
        const nextHeight = clamp(startHeight + (startY - moveEvent.clientY), MIN_HEIGHT, maxHeight);
        panel.style.height = `${nextHeight}px`;
      }
    };

    const onUp = () => {
      panel.classList.remove("is-resizing");
      document.removeEventListener("pointermove", onMove);
      document.removeEventListener("pointerup", onUp);
    };

    document.addEventListener("pointermove", onMove);
    document.addEventListener("pointerup", onUp);
  };

  resizeCorner.addEventListener("pointerdown", (e) => startResize(e, "both"));
  resizeTop.addEventListener("pointerdown", (e) => startResize(e, "y"));
  resizeLeft.addEventListener("pointerdown", (e) => startResize(e, "x"));

  toggleBtn.addEventListener("click", () => setOpen(!open));
  closeBtn.addEventListener("click", () => setOpen(false));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const value = input.value.trim();
    if (!value) return;
    respond(value);
    input.value = "";
  });

  suggestionsEl.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement) || !target.classList.contains("chat-suggestion")) return;
    const questions = {
      Alcances: "¿Qué incluye tu proyecto?",
      Horario: "¿Cuál es su horario de atención?",
      Cotización: "¿Cómo pido una cotización?",
      Marcas: "¿Con qué marcas trabajan?",
    };
    respond(questions[target.textContent ?? ""] ?? target.textContent ?? "");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) setOpen(false);
  });
</script>
