---
import { SERVICES } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="alcance" class="relative">
  <div class="absolute -top-8 left-1/2 -translate-x-1/2 z-10 w-16 h-16 rounded-full bg-white shadow-lg shadow-vacrc-ink-900/10 flex items-center justify-center text-vacrc-blue-500">
    <Icon icon="fan" ring={false} class="w-8 h-8" />
  </div>

  <div class="py-16 md:py-20 px-5 sm:px-8 bg-white">
    <div class="reveal max-w-2xl mx-auto text-center">
      <span class="text-eyebrow text-vacrc-blue-600 font-montserrat font-bold text-[0.99rem] text-justify">Lo que incluye tu proyecto</span>
      <h2 class="text-h2 mt-3 text-metal">
        El desarrollo integral de tu proyecto de climatización
      </h2>
    </div>
  </div>

  {SERVICES.map((service, i) => (
    <div class:list={["py-8 md:py-10", i % 2 === 0 ? "bg-vacrc-bg-soft" : "bg-white"]}>
      <div
        class:list={[
          "reveal max-w-[1440px] mx-auto px-5 sm:px-8 flex flex-col items-center md:items-stretch md:min-h-[460px] gap-10 md:gap-16",
          i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
        ]}
      >
        <div class="w-full md:w-[60%] shrink-0">
          <div class="relative h-96 md:aspect-auto md:h-full md:min-h-[320px] rounded-2xl overflow-hidden bg-vacrc-ink-900 shadow-sm shadow-vacrc-ink-900/[0.06]">
            <img
              src={`/hero/${service.slug}.png`}
              onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
              alt={service.name}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="w-full md:w-[40%] flex flex-col md:justify-center">
          <h3 class="text-card-title text-vacrc-blue-600">{service.name}</h3>
          <p class="text-lead mt-5 text-vacrc-ink-500 font-montserrat font-medium text-[1.056rem] sm:text-[1.188rem] leading-normal text-justify">{service.description}</p>

          <p class="text-includes-label mt-7 text-vacrc-ink-900 font-montserrat font-medium text-[1.056rem] sm:text-[1.188rem] text-justify">Lo que incluye</p>
          <ul class="mt-3 flex flex-col gap-y-2">
            {service.bullets.map((bullet) => (
              <li class="flex items-center gap-2 text-vacrc-ink-600 font-montserrat font-normal text-[1.056rem] sm:text-[1.188rem] text-justify">
                <span class="w-1.5 h-1.5 rounded-full bg-vacrc-blue-500 shrink-0"></span>
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  ))}
</section>
