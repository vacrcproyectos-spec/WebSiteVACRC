---
import { SERVICES } from "../data/site";
---

<section id="alcance" class="relative bg-vacrc-bg overflow-hidden">
  <!-- Encabezado de Sección Minimalista -->
  <div class="pt-24 pb-16 px-5 sm:px-8 max-w-7xl mx-auto text-center" data-aos="fade-up">
    <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-3">
      Proceso Editorial
    </span>
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-display font-bold text-white tracking-tight max-w-3xl mx-auto leading-tight">
      El desarrollo integral de tu proyecto de climatización
    </h2>
  </div>

  <!-- Lista de Pasos Bugatti-Style -->
  <div class="flex flex-col">
    {SERVICES.map((service, i) => {
      const isEven = i % 2 === 1;
      const stepNumber = String(i + 1).padStart(2, "0");
      const totalSteps = String(SERVICES.length).padStart(2, "0");

      return (
          <div class="relative group" data-aos="fade-up">
            <!-- Separador Minimalista entre Pasos -->
            {i > 0 && (
                <div class="w-full bg-vacrc-bg py-6 flex items-center justify-center gap-4">
                  <div class="h-px w-12 sm:w-24 bg-gradient-to-r from-transparent to-white/20"></div>
                  <span class="text-[0.65rem] font-mono uppercase tracking-[0.25em] text-white/40">
                Fase {stepNumber}
              </span>
                  <div class="h-px w-12 sm:w-24 bg-gradient-to-l from-transparent to-white/20"></div>
                </div>
            )}

            <!-- Card/Bloque Principal full-bleed -->
            <div class="relative min-h-[80vh] md:min-h-[88vh] flex items-end md:items-center overflow-hidden">
              <!-- Imagen de Fondo con Zoom Sutil al pasar el cursor -->
              <img
                  src={`/hero/${service.slug}.png`}
                  onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
                  alt={service.name}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
              />

              <!-- Overlay de Sombra Direccional para Lectura Directa -->
              <div
                  class:list={[
                    "absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20 md:bg-gradient-to-r",
                    isEven
                        ? "md:from-transparent md:via-black/60 md:to-black/90"
                        : "md:from-black/90 md:via-black/60 md:to-transparent"
                  ]}
              ></div>

              <!-- Contenido Directo en la Imagen -->
              <div class="relative max-w-7xl mx-auto px-6 sm:px-12 w-full py-16 md:py-24 z-10">
                <div class:list={["max-w-xl lg:max-w-2xl", isEven ? "md:ml-auto" : ""]}>

                  <!-- Metadatos de Paso -->
                  <div class="flex items-center gap-3 mb-4">
                  <span class="text-4xl sm:text-6xl font-display font-black text-vacrc-cyan-400 tracking-tighter leading-none">
                    {stepNumber}
                  </span>
                    <span class="text-white/30 text-xl font-light">/</span>
                    <span class="text-xs uppercase tracking-[0.25em] text-white/60 font-montserrat font-semibold">
                    Paso {stepNumber} de {totalSteps}
                  </span>
                  </div>

                  <!-- Título del Servicio -->
                  <h3 class="text-3xl sm:text-5xl lg:text-6xl font-display font-bold text-white tracking-tight leading-tight">
                    {service.name}
                  </h3>

                  <!-- Descripción Líder -->
                  <p class="mt-4 md:mt-6 text-white/80 font-montserrat text-sm sm:text-base md:text-lg font-light leading-relaxed">
                    {service.description}
                  </p>

                  <!-- Puntos Incluidos -->
                  <div class="mt-8 pt-6 border-t border-white/15">
                  <span class="block text-xs uppercase tracking-[0.2em] text-vacrc-cyan-400 font-montserrat font-bold mb-4">
                    Especificaciones e Inclusiones
                  </span>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
                      {service.bullets.map((bullet) => (
                          <li class="flex items-center gap-3 text-white/90 font-montserrat text-xs sm:text-sm font-normal">
                            <span class="w-1.5 h-1.5 rounded-full bg-vacrc-cyan-400 shrink-0"></span>
                            <span>{bullet}</span>
                          </li>
                      ))}
                    </ul>
                  </div>

                </div>
              </div>
            </div>
          </div>
      );
    })}
  </div>
</section>
