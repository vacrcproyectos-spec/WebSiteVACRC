---
import { SPECIALTIES } from "../data/site";
import Icon from "./Icon.astro";
import SectionDivider from "./SectionDivider.astro";

const chunkSize = 4;
const rows = Array.from({ length: Math.ceil(SPECIALTIES.length / chunkSize) }, (_, i) =>
  SPECIALTIES.slice(i * chunkSize, i * chunkSize + chunkSize)
);
---

<section id="especialidades" class="relative py-24 md:py-32 bg-white border-t border-vacrc-ink-100">
  <SectionDivider />
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="max-w-2xl" data-aos="fade-up">
      <span class="text-eyebrow text-vacrc-blue-600 font-montserrat font-bold text-[0.99rem] text-justify">Nos Especializamos En</span>
      <h2 class="text-h2 mt-3 text-metal">
        Proyectos de climatización para cada tipo de espacio
      </h2>
      <p class="text-lead mt-4 text-vacrc-ink-500 font-montserrat font-medium text-[1.056rem] sm:text-[1.188rem] leading-normal text-justify">
        Cotizamos y desarrollamos proyectos de climatización a la medida de cada giro. Pasa el cursor sobre cada uno para ver más.
      </p>
    </div>

    <div class="mt-14 md:mt-16 space-y-3">
      {rows.map((row) => (
        <div class="flex flex-col md:flex-row gap-3 md:h-[460px]">
          {row.map((item, itemIndex) => (
            <div
              class="group relative w-full h-80 md:h-full md:flex-1 md:min-w-0 overflow-hidden rounded-2xl bg-vacrc-ink-900 cursor-pointer md:transition-[flex-grow] md:duration-700 md:ease-out md:hover:flex-[2.5]"
              data-aos="fade-up"
              data-aos-delay={Math.min(itemIndex + 1, 4) * 300}
            >
              <img
                src={`/especialidades/${item.slug}.png`}
                onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
                alt={item.name}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-vacrc-ink-900/90 via-vacrc-ink-900/25 to-transparent"></div>

              <div class="absolute inset-x-0 bottom-0 p-5">
                <div class="w-10 h-10 rounded-lg bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-white">
                  <Icon icon={item.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-tile-title text-white mt-3 text-2xl sm:text-[1.75rem]">{item.name}</h3>
                <p class="text-tile-body mt-2 text-white/80 font-montserrat font-normal text-[1.056rem] sm:text-[1.188rem] text-justify max-h-40 opacity-100 overflow-hidden transition-all duration-500 md:max-h-0 md:opacity-0 md:group-hover:max-h-40 md:group-hover:opacity-100">
                  {item.short}
                </p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
