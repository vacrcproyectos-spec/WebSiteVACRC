<svg viewBox="0 0 24 24" fill="none" class={className} xmlns="http://www.w3.org/2000/svg">
  <path d="M12 3V19" stroke="currentColor" stroke-width="1.2" />
  <path d="M5 21H19" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" />
  <path d="M12 5L4 7.5M12 5L20 7.5" stroke="currentColor" stroke-width="1.2" />
  <path d="M4 7.5L1.5 13H6.5L4 7.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" />
  <path d="M20 7.5L17.5 13H22.5L20 7.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" />
</svg>
    )}

{icon === "gem" && (
<svg viewBox="0 0 24 24" fill="none" class={className} xmlns="http://www.w3.org/2000/svg">
  <path d="M3 9L12 21L21 9L17 3H7L3 9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill-opacity="0.04" fill="currentColor" />
