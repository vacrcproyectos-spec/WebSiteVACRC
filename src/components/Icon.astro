  <path d="M12 3C8.13 3 5 6.13 5 10C5 12.5 6.3 14.2 7.6 15.4C8.3 16.05 8.5 16.4 8.5 17.5H15.5C15.5 16.4 15.7 16.05 16.4 15.4C17.7 14.2 19 12.5 19 10C19 6.13 15.87 3 12 3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" />
</svg>
    )}

{icon === "team" && (
<svg viewBox="0 0 24 24" fill="none" class={className} xmlns="http://www.w3.org/2000/svg">
  <rect x="6" y="5" width="5" height="5" stroke="currentColor" stroke-width="1.2" />
