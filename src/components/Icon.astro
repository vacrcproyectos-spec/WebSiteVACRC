---
interface Props {
  icon: string;
  class?: string;
  ring?: boolean;
}
const { icon, class: className = "w-8 h-8", ring = true } = Astro.props;
---

{icon === "fan" && (
<svg viewBox="0 0 48 48" fill="none" class={className} xmlns="http://www.w3.org/2000/svg">
  {ring && <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.2" stroke-dasharray="4 2" />}
  <g class="origin-center">
    <path d="M24 24C24 24 22 10 28 6C33 3 38 7 36 13C34 18 24 24 24 24Z" fill="currentColor" fill-opacity="0.85" />
    <path d="M24 24C24 24 38 22 42 28C45 33 41 38 35 36C30 34 24 24 24 24Z" fill="currentColor" fill-opacity="0.7" />
    <path d="M24 24C24 24 26 38 20 42C15 45 10 41 12 35C14 30 24 24 24 24Z" fill="currentColor" fill-opacity="0.55" />
    <path d="M24 24C24 24 10 26 6 20C3 15 7 10 13 12C18 14 24 24 24 24Z" fill="currentColor" fill-opacity="0.4" />
  </g>
  <rect x="22" y="22" width="4" height="4" fill="currentColor" />
</svg>
    )}

