---
import { SITE, VALUES, ABOUT_IMAGES } from "../data/site";
import Icon from "./Icon.astro";

const strengths = [
  {
    title: "Ingeniería Propia",
    text: "Cada proyecto se calcula y diseña según las necesidades reales del espacio, sin basarse en catálogos genéricos.",
  },
  {
    title: "Equipo Certificado",
    text: "Técnicos certificados en manejo de refrigerantes y sistemas de climatización multimarca.",
  },
  {
    title: "Presupuestos Transparentes",
    text: "Cotizaciones detalladas, competitivas y sin costos ocultos durante la ejecución.",
  },
  {
    title: "Atención Ágil",
    text: "Diagnóstico y resolución rápida para proteger el confort y la continuidad operativa de tu espacio.",
  },
];
---

<section id="nosotros" class="relative bg-vacrc-bg overflow-hidden border-t border-white/10">

  <!-- Banner Full-Bleed / Hero Bugatti Style -->
  <div class="relative w-full h-[55vh] min-h-[400px] lg:h-[70vh] overflow-hidden group" data-aos="fade-up">
    <img
        src={ABOUT_IMAGES.equipo}
        onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
        alt={`Equipo de ${SITE.name}`}
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
    />
    <!-- Overlay de Gradiente para lectura limpia -->
    <div class="absolute inset-0 bg-gradient-to-t from-vacrc-bg via-black/40 to-transparent"></div>

    <div class="absolute bottom-0 inset-x-0 max-w-7xl mx-auto px-6 sm:px-8 pb-12 z-10">
      <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-3">
        Trayectoria & Compromiso
      </span>
      <h2 class="text-3xl sm:text-5xl lg:text-7xl font-display font-bold text-white tracking-tight leading-none">
        Más de una década diseñando clima de alta precisión
      </h2>
    </div>
  </div>

  <!-- Sección Introductoria: Quiénes Somos + Fotografía de Galería -->
  <div class="py-20 md:py-32 px-6 sm:px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Columna de Texto -->
      <div class="lg:col-span-7" data-aos="fade-up">
        <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-3">
          Nosotros
        </span>
        <h3 class="text-2xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight leading-tight mb-8">
          Especialistas en cotización y desarrollo de proyectos de climatización
        </h3>

        <div class="space-y-6 text-white/80 font-montserrat font-light text-base sm:text-lg leading-relaxed">
          <p>
            Somos especialistas en la cotización y desarrollo integral de proyectos de climatización en Yucatán. Acompañamos a centros comerciales, hoteles, desarrollos residenciales, plantas de producción, almacenes y áreas quirúrgicas que exigen precisión técnica.
          </p>
          <p>
            Como especialistas con más de 10 años en el sector, entregamos proyectos respaldados por <strong class="text-white font-semibold">ingeniería propia</strong> que cumplen las más altas especificaciones de seguridad, eficiencia energética y confort.
          </p>
        </div>

        <!-- Fortalezas / Especificaciones -->
        <div class="mt-12 pt-8 border-t border-white/15 grid sm:grid-cols-2 gap-8">
          {strengths.map((s, idx) => (
              <div>
              <span class="text-xs font-mono tracking-widest text-vacrc-cyan-400 block mb-2">
                0{idx + 1} //
              </span>
                <h4 class="font-display font-bold text-white text-lg sm:text-xl mb-2">{s.title}</h4>
                <p class="text-white/65 font-montserrat font-light text-xs sm:text-sm leading-relaxed">{s.text}</p>
              </div>
          ))}
        </div>
      </div>

      <!-- Fotografía Secundaria / Estilo Editorial sin Curvas -->
      <div class="lg:col-span-5" data-aos="fade-up" data-aos-delay="200">
        <div class="relative w-full h-[450px] lg:h-[620px] overflow-hidden border border-white/10 group">
          <img
              src={ABOUT_IMAGES.instalacion}
              onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
              alt={`Instalación de ${SITE.name}`}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <span class="text-xs uppercase tracking-[0.2em] text-white/50 font-montserrat">
              Estándares de Calidad
            </span>
            <p class="text-white font-display font-bold text-xl mt-1">
              Ejecución técnica sin margen de error
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Misión & Visión: Mosaico Asimétrico Split Screen -->
  <div class="w-full border-t border-white/10">
    <div class="grid lg:grid-cols-2 w-full">

      <!-- Bloque Misión -->
      <div class="relative min-h-[480px] lg:min-h-[580px] flex items-end p-8 sm:p-12 border-b lg:border-b-0 lg:border-r border-white/10 group overflow-hidden" data-aos="fade-up">
        <img
            src={ABOUT_IMAGES.mision}
            onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
            alt="Misión"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/70 to-black/30"></div>
        <div class="relative z-10 max-w-xl">
          <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-2">
            01 // Propósito
          </span>
          <h3 class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight mb-4">
            Misión
          </h3>
          <p class="text-white/80 font-montserrat font-light text-sm sm:text-base leading-relaxed">
            Ser el aliado técnico de confianza en la cotización y el desarrollo integral de proyectos de climatización, entregando un servicio con los más altos estándares de calidad y seguridad para centros comerciales, hoteles, departamentos, plantas de producción, almacenes y áreas especializadas.
          </p>
        </div>
      </div>

      <!-- Bloque Visión -->
      <div class="relative min-h-[480px] lg:min-h-[580px] flex items-end p-8 sm:p-12 group overflow-hidden" data-aos="fade-up" data-aos-delay="200">
        <img
            src={ABOUT_IMAGES.vision}
            onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
            alt="Visión"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/70 to-black/30"></div>
        <div class="relative z-10 max-w-xl">
          <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-2">
            02 // Horizonte
          </span>
          <h3 class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight mb-4">
            Visión
          </h3>
          <p class="text-white/80 font-montserrat font-light text-sm sm:text-base leading-relaxed">
            Ser la empresa de referencia en cotización y desarrollo de proyectos de climatización en la región, reconocida por la confiabilidad de nuestras soluciones de ingeniería y el compromiso inquebrantable con cada cliente.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Grid de Valores Minimalista Estilo Showcase -->
  <div class="py-24 md:py-32 px-6 sm:px-8 border-t border-white/10 max-w-7xl mx-auto" data-aos="fade-up">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-[0.3em] text-vacrc-cyan-400 font-montserrat font-bold block mb-3">
        Principios Rectores
      </span>
      <h3 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
        Nuestros Valores
      </h3>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-px bg-white/10 border border-white/10">
      {VALUES.map((value) => (
          <div class="bg-vacrc-bg p-6 sm:p-8 flex flex-col items-center justify-center text-center group hover:bg-white/[0.03] transition-colors duration-300">
            <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full border border-white/20 bg-black/40 flex items-center justify-center text-white/80 group-hover:text-vacrc-cyan-400 group-hover:border-vacrc-cyan-400/50 transition-all duration-300 mb-4">
              <Icon icon={value.icon} class="w-6 h-6 sm:w-8 sm:h-8" />
            </div>
            <span class="text-white/90 font-montserrat text-xs sm:text-sm font-medium tracking-wide uppercase">
            {value.name}
          </span>
          </div>
      ))}
    </div>
  </div>

</section>
