---
import { SITE, VALUES, ABOUT_IMAGES } from "../data/site";
import Icon from "./Icon.astro";
import SectionDivider from "./SectionDivider.astro";

const strengths = [
  {
    title: "Ingeniería propia",
    text: "Cada proyecto se calcula y diseña según las necesidades reales del espacio, no de catálogo.",
  },
  {
    title: "Equipo certificado",
    text: "Técnicos certificados en manejo de refrigerantes y equipos de climatización de todas las marcas.",
  },
  {
    title: "Presupuestos claros",
    text: "Cotizaciones detalladas y competitivas, sin costos ocultos.",
  },
  {
    title: "Atención rápida",
    text: "Diagnóstico y solución ágil para que no pierdas el confort en tu espacio.",
  },
];
---

<section id="nosotros" class="relative bg-white">
  <SectionDivider />
  <!-- Banner -->
  <div class="reveal relative mt-10 md:mt-14 min-h-[260px] lg:min-h-[420px] overflow-hidden">
    <img
      src={ABOUT_IMAGES.equipo}
      onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
      alt={`Equipo de ${SITE.name}`}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>

  <!-- Intro: quiénes somos + foto -->
  <div class="py-16 md:py-24 px-5 sm:px-8">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-start">
      <div class="reveal">
        <span class="font-mono text-xs uppercase tracking-widest text-vacrc-blue-600">Nosotros</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl mt-3 text-metal">
          Especialistas en cotización de proyectos de climatización
        </h2>

        <p class="mt-5 text-vacrc-ink-500 text-base leading-relaxed">
          Somos <strong class="text-vacrc-ink-900">especialistas en cotización y desarrollo de proyectos de climatización en Yucatán</strong>, acompañando a centros comerciales, hoteles, departamentos, plantas de producción, almacenes, bodegas y quirófanos que buscan un servicio técnico confiable.
        </p>

        <p class="mt-4 text-vacrc-ink-500 text-base leading-relaxed">
          Como especialistas desde hace más de 15 años en climatización, entregamos con <strong class="text-vacrc-ink-900">ingeniería propia</strong> proyectos que cumplen las más altas especificaciones y estándares de seguridad, eficiencia y calidad, para que nuestros clientes tomen decisiones informadas y sin sorpresas.
        </p>

        <p class="mt-4 text-vacrc-ink-500 text-base leading-relaxed">
          Desde el cálculo inicial hasta la entrega y el mantenimiento, acompañamos cada proyecto con presupuestos claros y tiempos de respuesta que protegen tu inversión.
        </p>

        <div class="mt-9 grid sm:grid-cols-2 gap-6">
          {strengths.map((s) => (
            <div class="flex gap-3">
              <span class="mt-1 w-1.5 h-1.5 rounded-full bg-vacrc-blue-500 shrink-0"></span>
              <div>
                <h3 class="font-semibold text-vacrc-ink-900">{s.title}</h3>
                <p class="text-sm text-vacrc-ink-500 mt-1">{s.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal reveal-delay-2">
        <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-vacrc-ink-900 shadow-sm shadow-vacrc-ink-900/[0.06]">
          <img
            src={ABOUT_IMAGES.instalacion}
            onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
            alt={`Instalación de ${SITE.name}`}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Misión, visión y valores -->
  <div class="relative py-20 md:py-28 px-5 sm:px-8 bg-vacrc-ink-900 overflow-hidden">
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-vacrc-blue-500/20 blur-[120px]"></div>

    <div class="relative max-w-7xl mx-auto">
      <div class="reveal grid sm:grid-cols-2 gap-6">
        <div class="rounded-2xl overflow-hidden bg-vacrc-ink-700/40 border border-white/10">
          <div class="relative aspect-[16/10]">
            <img
              src={ABOUT_IMAGES.mision}
              onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
              alt="Misión"
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-vacrc-ink-900/80 to-transparent"></div>
            <span class="absolute bottom-0 left-0 font-script text-2xl text-white bg-vacrc-blue-600/90 px-5 py-2 rounded-tr-xl">
              Misión
            </span>
          </div>
          <p class="p-6 text-sm text-white/80 leading-relaxed">
            Ser el aliado técnico de confianza en la cotización y el desarrollo integral de proyectos de climatización, entregando un servicio con los más altos estándares de calidad y seguridad para centros comerciales, hoteles, departamentos, plantas de producción, almacenes, bodegas y quirófanos.
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden bg-vacrc-ink-700/40 border border-white/10">
          <div class="relative aspect-[16/10]">
            <img
              src={ABOUT_IMAGES.vision}
              onerror="this.onerror=null;this.src='/hero/placeholder.svg';"
              alt="Visión"
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-vacrc-ink-900/80 to-transparent"></div>
            <span class="absolute bottom-0 left-0 font-script text-2xl text-white bg-vacrc-blue-600/90 px-5 py-2 rounded-tr-xl">
              Visión
            </span>
          </div>
          <p class="p-6 text-sm text-white/80 leading-relaxed">
            Ser la empresa de referencia en cotización y desarrollo de proyectos de climatización en la región, reconocida por la confiabilidad de nuestro servicio y el compromiso con cada cliente.
          </p>
        </div>
      </div>

      <div class="reveal reveal-delay-2 mt-16 md:mt-20 text-center">
        <h3 class="font-script text-3xl sm:text-4xl text-white">Valores</h3>
        <div class="mt-10 grid grid-cols-3 sm:grid-cols-6 gap-y-8 gap-x-4">
          {VALUES.map((value) => (
            <div class="flex flex-col items-center gap-3">
              <span class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white">
                <Icon icon={value.icon} class="w-10 h-10 sm:w-12 sm:h-12" />
              </span>
              <p class="text-xs font-semibold uppercase tracking-wide text-white/80 text-center leading-tight">
                {value.name}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

</section>
